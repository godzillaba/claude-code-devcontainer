# Tooling git config for the Claude Code sbx template.
#
# Installed to ~/.config/git/config (XDG global) rather than ~/.gitconfig so it
# does NOT shadow any user identity (user.name / user.email) that sbx or the
# user sets in ~/.gitconfig. Both files are read as "global" config.

[core]
	excludesfile = /home/agent/.gitignore_global
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	light = false
	line-numbers = true
	side-by-side = false

[merge]
	conflictstyle = diff3

[diff]
	colorMoved = default
